# Copy this file to .env and fill in real values. Never commit .env.

# Password officers use to log in to the admin page. Use a long passphrase (max 72 bytes).
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Postgres connection string for Supabase.
# Supabase → Connect → Transaction pooler (port 6543). Replace PASSWORD with
# the database password; ask a teammate for it, never commit the real value.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres
sslmode=verify-full&sslrootcert=certs/supabase-ca.crt